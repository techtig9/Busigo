NEXT_PUBLIC_APP_NAME=busigo
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# AI provider failover order: Groq -> Cerebras -> OpenRouter -> Anthropic
# Only GROQ_API_KEY is required. The remaining providers are optional fallbacks.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
CEREBRAS_API_URL=https://api.cerebras.ai/v1/chat/completions
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
RESEND_API_KEY=
# PADDLE_API_KEY: not read by any code path yet (only PADDLE_WEBHOOK_SECRET and the
# publishable NEXT_PUBLIC_PADDLE_CLIENT_TOKEN are used today) — kept as a placeholder for a
# future server-initiated Paddle API call (e.g. an admin action to cancel a subscription
# directly rather than only reacting to webhooks).
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_STARTER=
NEXT_PUBLIC_PADDLE_PRICE_STARTER_YEARLY=
NEXT_PUBLIC_PADDLE_PRICE_GROWTH=
NEXT_PUBLIC_PADDLE_PRICE_GROWTH_YEARLY=
NEXT_PUBLIC_PADDLE_PRICE_PRO=
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEARLY=
NEXT_PUBLIC_PADDLE_PRICE_TOPUP_5K=
NEXT_PUBLIC_PADDLE_PRICE_TOPUP_15K=
NEXT_PUBLIC_PADDLE_PRICE_TOPUP_40K=
CRON_SECRET=

# Phase 9 — OAuth + encrypted provider credentials
BUSIGO_TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

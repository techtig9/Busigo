# BusiGo environment
#
# Every variable the code reads, marked REQUIRED or OPTIONAL with what it is for.
# Copy to .env.local for development. Nothing here is a real value.
#
# BUILD-TIME vs RUNTIME matters on Vercel: every NEXT_PUBLIC_* value is inlined into the
# bundle when the app is built, so adding one afterwards needs a redeploy to take effect.
# Everything else is read per request and takes effect immediately. See
# docs/DEPLOY_VERCEL.md.
#
# The app degrades in stages rather than all-or-nothing: with NOTHING set, the public
# marketing site renders normally and every authenticated route redirects to
# /login?unconfigured=1. Nothing behind the login is ever served.

# ---------------------------------------------------------------------------------------
# Core — REQUIRED for anything past the marketing site
# ---------------------------------------------------------------------------------------

# REQUIRED (build time). Your Supabase project URL. Also composes the CSP's connect-src in
# next.config.js, so a build without it produces a policy that forbids the browser from
# reaching Supabase at all — sign-in then fails with a CSP violation, not an auth error.
NEXT_PUBLIC_SUPABASE_URL=

# REQUIRED (build time). Supabase anon/publishable key. Safe in the browser; RLS is what
# protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# REQUIRED (runtime). Supabase service-role key. Bypasses RLS entirely — used by the
# execution engine, the Paddle webhook and the admin panel. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# STRONGLY RECOMMENDED (runtime). The public origin of this deployment, e.g.
# https://busigo.app. Used for OAuth redirect URIs, Supabase email confirmation and
# password-reset links, and workspace invite links. When unset these are derived from the
# request's forwarded host, which works — but an OAuth redirect_uri must match the value
# registered with the provider exactly, and a Vercel deployment answers on several
# hostnames, so pin it here before enabling any app connection.
NEXT_PUBLIC_SITE_URL=

# OPTIONAL (build time). Product name shown in the UI. Defaults to "busigo".
NEXT_PUBLIC_APP_NAME=busigo

# ---------------------------------------------------------------------------------------
# AI providers — failover order is Groq -> Cerebras -> OpenRouter -> Anthropic
# Failover happens ONLY on rate-limit/quota responses, never on a configuration error or a
# bad request, so a genuine failure surfaces instead of being masked.
# ---------------------------------------------------------------------------------------

# REQUIRED for AI Actions, AI Studio, the Copilot and the opportunity scanner. Without at
# least one provider key these surfaces report "not configured" rather than failing at run
# time. Business analysis has a deterministic fallback and still works without any of them.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile                                    # OPTIONAL — override the default model
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions          # OPTIONAL — override the endpoint

# OPTIONAL. Second in the failover order.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
CEREBRAS_API_URL=https://api.cerebras.ai/v1/chat/completions

# OPTIONAL. Third in the failover order.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# OPTIONAL. Last resort in the failover order.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages

# ---------------------------------------------------------------------------------------
# Billing (Paddle) — OPTIONAL. Without these, plans display but checkout cannot open.
# ---------------------------------------------------------------------------------------

# REQUIRED IF billing is enabled (runtime). Paddle notification webhook signing secret.
# The webhook REFUSES every request when this is unset — it does not fall back to an empty
# key, because HMAC with an empty key is computable and anyone could then forge a
# "subscription.updated" and grant themselves a paid plan.
PADDLE_WEBHOOK_SECRET=

# REQUIRED IF billing is enabled (build time). Paddle client-side token for the checkout
# overlay.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# REQUIRED IF billing is enabled (build time). Paddle price IDs. These are read by BOTH the
# checkout buttons and the webhook's price-to-plan mapping, so a price that is not listed
# here opens no checkout AND grants no plan. An unrecognised price at webhook time leaves
# the customer's plan untouched and logs — it never downgrades them to free.
NEXT_PUBLIC_PADDLE_PRICE_STARTER=
NEXT_PUBLIC_PADDLE_PRICE_STARTER_YEARLY=
NEXT_PUBLIC_PADDLE_PRICE_GROWTH=
NEXT_PUBLIC_PADDLE_PRICE_GROWTH_YEARLY=
NEXT_PUBLIC_PADDLE_PRICE_PRO=
NEXT_PUBLIC_PADDLE_PRICE_PRO_YEARLY=

# OPTIONAL (build time). One-off credit top-up price IDs.
NEXT_PUBLIC_PADDLE_PRICE_TOPUP_5K=
NEXT_PUBLIC_PADDLE_PRICE_TOPUP_15K=
NEXT_PUBLIC_PADDLE_PRICE_TOPUP_40K=

# ---------------------------------------------------------------------------------------
# Email — OPTIONAL. Without this, transactional email is skipped rather than failing.
# ---------------------------------------------------------------------------------------

# OPTIONAL (runtime). Resend API key for transactional email and the Send Email workflow step.
RESEND_API_KEY=

# ---------------------------------------------------------------------------------------
# Scheduled execution — OPTIONAL
# ---------------------------------------------------------------------------------------

# REQUIRED IF scheduled workflow triggers are used (runtime). Shared secret the cron caller
# must present to /api/cron/tick. Without it the endpoint has no caller authentication.
CRON_SECRET=

# ---------------------------------------------------------------------------------------
# App connections (OAuth) — OPTIONAL. Each provider appears in Connect only when its pair
# is set; an unconfigured provider is hidden rather than shown and broken.
# ---------------------------------------------------------------------------------------

# REQUIRED IF any OAuth provider is enabled (runtime). 32-byte key, base64, used to encrypt
# stored provider access/refresh tokens at rest. Generate with:
#   openssl rand -base64 32
# Rotating this makes every stored connection undecryptable — users must reconnect.
BUSIGO_TOKEN_ENCRYPTION_KEY=

# REQUIRED IF any OAuth provider is enabled (runtime). Signs the OAuth state parameter,
# which is what prevents CSRF on the callback. Generate with:
#   openssl rand -base64 32
OAUTH_STATE_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
